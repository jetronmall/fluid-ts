{
  "name": "@jetronticket/api",
  "version": "0.1.1",
  "description": "TypeScript client for Jetron Fluid, the Jetron Ticket headless API.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jetronmall/fluid-ts.git",
    "directory": "packages/api"
  },
  "homepage": "https://github.com/jetronmall/fluid-ts/tree/main/packages/api#readme",
  "bugs": {
    "url": "https://github.com/jetronmall/fluid-ts/issues"
  },
  "type": "module",
  "sideEffects": false,
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      },
      "require": {
        "types": "./dist/index.d.cts",
        "default": "./dist/index.cjs"
      }
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist .turbo"
  },
  "publishConfig": {
    "access": "public"
  },
  "devDependencies": {
    "@jetronticket/eslint-config": "workspace:*",
    "@jetronticket/typescript-config": "workspace:*",
    "@types/node": "^26.1.2",
    "eslint": "^10.8.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3"
  }
}
